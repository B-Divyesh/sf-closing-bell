{
  "name": "closing-bell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "npm run typecheck",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:server && playwright test",
    "test:server": "node --test server/*.test.mjs",
    "realtime": "node server/server.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@types/ws": "^8.5.14",
    "typescript": "~5.7.2",
    "vite": "~6.4.3"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
